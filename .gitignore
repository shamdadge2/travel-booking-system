# =========================================================
# Root .gitignore — Travel Package Booking System
# =========================================================

# ---------- Backend (Python / Django) ----------
backend/venv/
backend/env/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/db.sqlite3
backend/staticfiles/
backend/media/*
!backend/media/.gitkeep
backend/.env
*.log

# ---------- Frontend (Node / Vite) ----------
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ---------- Editors / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- Misc ----------
*.sqlite3
*.pot
*.pyo
