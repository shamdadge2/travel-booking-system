# =========================================================
# Environment variables template.
# Copy this file to ".env" and fill in real values.
# =========================================================

# --- Core Django settings ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Set USE_SQLITE=True to run without PostgreSQL installed (dev/testing only).
# On Render: leave USE_SQLITE unset/False — Render's managed Postgres
# automatically injects a DATABASE_URL env var, which settings.py
# picks up before falling back to the vars below.
USE_SQLITE=True

DATABASE_NAME=travel_booking_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- CORS (frontend origins allowed to call the API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Google Sign-In ---
# From Google Cloud Console > APIs & Services > Credentials >
# OAuth 2.0 Client ID (Web application). Leave blank to disable
# Google sign-in — the "Sign in with Google" button will show a
# clear error instead of crashing if this isn't set.
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID=612145266893-a3p0i202koi1o5pdvhqdhti1dmu26amj.apps.googleusercontent.com

# --- Razorpay (Test Mode FREE) ---
# Get from https://dashboard.razorpay.com -> Test Mode -> Settings -> API Keys -> Generate Test Key
# Leave blank for local dev without payments - frontend will show demo note.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# --- Media storage (Cloudinary) ---
# Required on Render/production. Uploaded images are stored here so they
# survive deploys/restarts (Render's disk is ephemeral). Get this from your
# Cloudinary dashboard (Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
# Leave blank for local dev — media then uses the local filesystem.
CLOUDINARY_URL=
