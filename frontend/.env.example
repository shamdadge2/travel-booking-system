VITE_API_BASE_URL=http://127.0.0.1:8000/api

# From Google Cloud Console > APIs & Services > Credentials >
# OAuth 2.0 Client ID (Web application). Must match the backend's
# GOOGLE_CLIENT_ID exactly — same OAuth client, both sides.
VITE_GOOGLE_CLIENT_ID=

# Razorpay Test Mode (FREE) - from https://dashboard.razorpay.com -> Test Mode -> API Keys
# Use rzp_test_... for testing, switch to rzp_live_... after KYC
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
